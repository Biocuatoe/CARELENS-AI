# ============================================================
# Firebase Realtime Database — EcoPatch telemetry (server-side only)
# ============================================================
# URL of the Firebase Realtime Database that receives EcoPatch sensor data.
# Leave empty to disable the Firebase bridge (Telegram-only mode).
FIREBASE_DATABASE_URL=https://ecopatch-c6864-default-rtdb.asia-southeast1.firebasedatabase.app

# Sub-path within the database to listen on (default: "sensor").
# The bridge listens at /<FIREBASE_DATABASE_PATH> and processes all child changes.
FIREBASE_DATABASE_PATH=sensor

# Path to the Firebase service account JSON file (server-side admin).
# Required if the database requires authentication.
# DO NOT commit this file — use GOOGLE_APPLICATION_CREDENTIALS or Workload Identity.
# Example: GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# Telegram Bot — REQUIRED for demo control via Telegram
# ============================================================

# Bot token from @BotFather (keep this secret!)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram chat IDs allowed to control the demo.
# Get your chat ID from @userinfobot or from the Telegram API.
# Example: 123456789,987654321
ALLOWED_CHAT_IDS=

# Optional: comma-separated list of Telegram user IDs. If set, BOTH chat_id
# AND user_id must be in their respective sets. If empty, only chat_id is checked.
# Get your user ID from @userinfobot.
# Example: 111222333,444555666
ALLOWED_USER_IDS=

# Your own Telegram chat ID — the bot sends a startup confirmation here.
# Get it from @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=

# ============================================================
# Server
# ============================================================

PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
