# Mode: polling (default) or webhook
BRIDGE_MODE=polling

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (get it from @userinfobot or logs)
TELEGRAM_ALLOWED_CHAT_ID=

# Web origin for CORS/info
WEB_ORIGIN=https://your-web-url.a.run.app

# Secret for webhook verification (generate with: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# Public URL for webhook (only if BRIDGE_MODE=webhook)
TELEGRAM_WEBHOOK_PUBLIC_URL=https://your-bridge-url.a.run.app

# Google Cloud Secret Manager (only if SM_ENABLED=1)
SM_ENABLED=0
GOOGLE_CLOUD_PROJECT=your-project-id
