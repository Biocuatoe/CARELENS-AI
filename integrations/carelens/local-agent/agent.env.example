# CareLens Local AI Agent settings. Copy to agent.env (git-ignored) and fill in. Never commit agent.env.
# The launcher loads this file into the agent process only; values are never printed.

# Cloud backend (Cloudflare Worker) base URL. https:// required except for a local wrangler dev backend.
CARELENS_BACKEND_URL=https://care-monitoring.<your-subdomain>.workers.dev
# Agent credential issued once by POST /api/admin/v1/agents (starts with cla_).
CARELENS_AGENT_TOKEN=

# Local services. Must be loopback addresses: frames and prompts never leave this PC.
CARELENS_VISION_URL=http://127.0.0.1:8080
CARELENS_OLLAMA_URL=http://127.0.0.1:11434
CARELENS_SUMMARY_MODEL=qwen3:4b-instruct-2507-q4_K_M
CARELENS_PACKAGE_VERSION=carelens_models_v1_20261018

# Optional tuning (defaults shown).
# CARELENS_LEASE_SECONDS=120
# CARELENS_POLL_INTERVAL_S=30            fallback poll for vision jobs (hints arrive over SSE first)
# CARELENS_REPORT_POLL_INTERVAL_S=300
# CARELENS_OLLAMA_KEEP_ALIVE=0           unload the LLM after each report so the Vision server keeps VRAM
# CARELENS_OLLAMA_NUM_CTX=6144
# CARELENS_AGENT_RUN_DIR=                default: <local-agent>\run (agent.log, agent.pid, stop.request)
